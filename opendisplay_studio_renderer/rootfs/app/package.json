{
  "name": "opendisplay-studio-renderer",
  "version": "0.6.0",
  "private": true,
  "description": "Persistent Chromium HTML-to-PNG renderer",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
